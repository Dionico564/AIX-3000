    document.getElementById('status').textContent = '✅ KGB & Campobasso Database Loaded — Ready to Scan & Learn';
  }catch(e){
    tfReady = false;
    document.getElementById('status').textContent = '⚠️ Database Ready — Offline Mode Active';
  }
}

function showSpecies(id){
  currentSpecies = id;
  const s = speciesDB[id];
  document.querySelectorAll('.tab').forEach(t=>t.classList.remove('active'));
  event.target.classList.add('active');
  document.getElementById('speciesIcon').textContent = s.icon;
  document.getElementById('speciesTitle').textContent = s.name;
  document.getElementById('speciesTitle').className = `species-name ${s.class}`;
  document.getElementById('speciesDesc').innerHTML = `
    <strong>🌌 Origin:</strong> ${s.origin}<br>
    <strong>👤 Physical:</strong> ${s.physical}<br>
    <strong>👁️ Iris Markers:</strong> ${s.irisPattern}<br>
    <strong>🎯 Agenda:</strong> ${s.agenda}<br>
    <strong>📚 Source:</strong> ${s.kgb_class} — ${s.campobasso}<br>
    <strong>🔬 Analysis:</strong> ${s.analysis}
  `;
  speak(`${s.name}. Origin: ${s.origin}. ${s.agenda}. Confidence range: ${s.confidence}.`);
}

async function initCamera(){
  try{
    const stream = await navigator.mediaDevices.getUserMedia({
      video:{facingMode:'user',width:{ideal:640},height:{ideal:480}},
      audio:false
    });
    document.getElementById('video').srcObject = stream;
    await document.getElementById('video').play();
  }catch(e){
    document.getElementById('status').textContent = '⚠️ Camera permission needed for face/iris scan — using pattern analysis';
  }
}


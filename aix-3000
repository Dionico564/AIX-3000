  document.getElementById('status').innerHTML = '<span class="loading"></span>Scanning facial geometry, iris color/patterns, cranial structure...';
  speak('Initiating face and iris scan. Analyzing extraterrestrial lineage markers. Processing KGB and Campobasso database patterns.');

  await new Promise(r=>setTimeout(r, 3000));

  // ===== SELECT MATCHING EXTRATERRESTRIAL SPECIES =====
  const rand = Math.random();
  let match;
  if(rand < 0.15) match = 'nordic';
  else if(rand < 0.28) match = 'pleiadian';
  else if(rand < 0.40) match = 'grey';
  else if(rand < 0.52) match = 'andromedan';
  else if(rand < 0.63) match = 'annunaki';
  else if(rand < 0.74) match = 'zeta';
  else if(rand < 0.83) match = 'reptilian';
  else if(rand < 0.90) match = 'arsir';
  else if(rand < 0.95) match = 'mantid';
  else match = 'alpha';

  const s = speciesDB[match];
  const confidence = (82 + Math.random()*15).toFixed(1);

  document.getElementById('speciesIcon').textContent = s.icon;
  document.getElementById('speciesTitle').textContent = `🔬 MATCH: ${s.name}`;
  document.getElementById('speciesTitle').className = `species-name ${s.class}`;
  document.getElementById('speciesDesc').innerHTML = `
    <strong>✅ Extraterrestrial Lineage Detected — Confidence: ${confidence}%</strong><br><br>
    <strong>🌌 Origin:</strong> ${s.origin}<br>
    <strong>👁️ Iris Markers Found:</strong> ${s.irisPattern}<br>
    <strong>📐 Facial Match:</strong> Cranial structure, eye geometry, and symmetry match ${s.name} profile.<br>
    <strong>🧬 Frequency Alignment:</strong> Your consciousness patterns align with ${s.name} signature.<br><br>
    <strong>📖 Full Profile:</strong><br>${s.physical}<br><br>
    <strong>🎯 Agenda & Nature:</strong> ${s.agenda}<br><br>
    <em>${s.analysis}</em><br><br>
    <strong>📚 Source:</strong> ${s.kgb_class} — ${s.campobasso}
  `;

  document.getElementById('status').textContent = `✅ Scan Complete — ${s.name} — ${confidence}% Confidence`;
  speak(`Scan complete. Extraterrestrial lineage detected. Primary match: ${s.name}. Confidence: ${confidence} percent. Origin: ${s.origin}. ${s.agenda}. ${s.analysis}`);

  conversationMemory.push({role:'ai',type:'scan',result:match,confidence:confidence});
  btn.disabled = false;
}

function speak(text){
  if('speechSynthesis' in window){
    speechSynthesis.cancel();
    const utt = new SpeechSynthesisUtterance(text);
    utt.volume = 1; utt.rate = 1; utt.pitch = 1.05;
    speechSynthesis.speak(utt);
  }
}

function sendQuery(){
  const input = document.getElementById('userInput');
  const text = input.value.trim();
  if(!text) return;
  input.value = '';

  const log = document.getElementById('chatLog');
  log.innerHTML += `<div class="log-entry">👤 You: ${text}</div>`;
  conversationMemory.push({role:'user',text:text});

  const reply = generateReply(text);
  conversationMemory.push({role:'ai',text:reply});
  log.innerHTML += `<div class="log-entry">👽 AIX-3000: ${reply}</div>`;
  log.scrollTop = log.scrollHeight;

  speak(reply);
}

function generateReply(q){
  const query = q.toLowerCase();
  for(const [key,val] of Object.entries(knowledgeBase)){
    if(query.includes(key)) return val;
  }
  for(const [id,s] of Object.entries(speciesDB)){
    if(query.includes(id) || query.includes(s.name.toLowerCase().split(' ')[0])){
      return `${s.name} — Origin: ${s.origin}. ${s.agenda}. ${s.kgb_class}. ${s.campobasso}. Iris markers: ${s.irisPattern}.`;
    }
  }
  if(query.includes('hello') || query.includes('hi')){
    return 'Greetings, cosmic traveler. I am AIX-3000 — Extraterrestrial Species Intelligence AI. My database contains all races from the KGB Secret Files and the Extraterrestrial Species Almanac by Craig Campobasso. Ask me about any ET race — or scan your face and iris to discover your cosmic lineage markers.';
  }
  if(query.includes('which race am i') || query.includes('my lineage') || query.includes('who am i')){
    return 'Tap the Scan button above — I will analyze your facial structure, eye shape, and iris patterns against the complete KGB & Campobasso database to identify your strongest extraterrestrial lineage markers. No scan is 100% definitive — we are all cosmic beings with many frequencies within us.';
  }
  if(query.includes('most benevolent') || query.includes('good')){
    return '🌟 <strong>Andromedans</strong> — oldest, wisest, most benevolent — cosmic guardians. ✨ <strong>Nordic/Pleiadians</strong> — our closest cosmic siblings, peaceful and loving. ☀️ <strong>Arsir/Sirians</strong> — ancient wise teachers and allies. These races serve others and assist humanity\'s evolution.';
  }
  if(query.includes('most dangerous') || query.includes('evil')){
    return '🔴 <strong>Alpha Draconis / Royal Reptilians</strong> — highest threat, imperialistic, seek total dominion. They claim ancient ownership of Earth. 🦎 <strong>Reptilian</strong> — territorial, control-oriented. ⚠️ However — "evil" is a human judgment. They follow their own nature and survival instincts. Free will applies to all races.';
  }
  if(query.includes('kgb') || query.includes('campobasso')){
    return '📚 <strong>KGB Alien Races Files</strong> — Soviet Union classified data, 1950–1991. 5 threat classes. <strong>Craig Campobasso — Extraterrestrial Species Almanac</strong> — definitive modern reference, 70+ species, comprehensive profiles. AIX-3000 integrates BOTH databases for complete analysis.';
  }
  return 'I hold complete knowledge of all extraterrestrial races from the KGB Secret Alien Races Files and the Extraterrestrial Species Almanac by Craig Campobasso. Ask me about Greys, Nordics, Reptilians, Pleiadians, Anunnaki, Zetas, Andromedans, Mantids, Alpha Draconis, Sirians, origins, agendas, star systems, contact history, or cosmic lineage — or tap Scan to analyze your face and iris.';
}

